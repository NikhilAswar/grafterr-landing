<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 560 420" fill="none">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#dbeafe"/>
      <stop offset="100%" stop-color="#bfdbfe"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#6366f1"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#f97316"/>
      <stop offset="100%" stop-color="#fb923c"/>
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="560" height="420" fill="url(#bgGrad)"/>
  
  <!-- Dashboard card -->
  <rect x="40" y="40" width="480" height="340" rx="16" fill="white" opacity="0.9"/>
  
  <!-- Header bar -->
  <rect x="40" y="40" width="480" height="56" rx="16" fill="url(#cardGrad)"/>
  <rect x="40" y="72" width="480" height="24" fill="url(#cardGrad)"/>
  
  <!-- Header dots -->
  <circle cx="76" cy="68" r="6" fill="white" opacity="0.4"/>
  <circle cx="96" cy="68" r="6" fill="white" opacity="0.4"/>
  <circle cx="116" cy="68" r="6" fill="white" opacity="0.4"/>
  <rect x="200" y="60" width="120" height="16" rx="8" fill="white" opacity="0.2"/>
  
  <!-- Stat cards -->
  <rect x="64" y="116" width="120" height="80" rx="10" fill="#eff6ff"/>
  <rect x="64" y="116" width="120" height="4" rx="2" fill="url(#cardGrad)"/>
  <rect x="80" y="136" width="60" height="10" rx="5" fill="#93c5fd"/>
  <rect x="80" y="154" width="80" height="18" rx="4" fill="#3b82f6"/>
  <rect x="80" y="178" width="50" height="8" rx="4" fill="#bfdbfe"/>

  <rect x="204" y="116" width="120" height="80" rx="10" fill="#fff7ed"/>
  <rect x="204" y="116" width="120" height="4" rx="2" fill="url(#accentGrad)"/>
  <rect x="220" y="136" width="60" height="10" rx="5" fill="#fed7aa"/>
  <rect x="220" y="154" width="80" height="18" rx="4" fill="#f97316"/>
  <rect x="220" y="178" width="50" height="8" rx="4" fill="#fed7aa"/>

  <rect x="344" y="116" width="120" height="80" rx="10" fill="#f0fdf4"/>
  <rect x="344" y="116" width="120" height="4" rx="2" fill="#22c55e"/>
  <rect x="360" y="136" width="60" height="10" rx="5" fill="#86efac"/>
  <rect x="360" y="154" width="80" height="18" rx="4" fill="#22c55e"/>
  <rect x="360" y="178" width="50" height="8" rx="4" fill="#bbf7d0"/>
  
  <!-- Chart area -->
  <rect x="64" y="216" width="280" height="130" rx="10" fill="#f8fafc"/>
  <polyline points="80,320 110,290 140,300 170,270 200,280 230,250 260,260 290,230 320,240" 
    fill="none" stroke="#3b82f6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
  <polyline points="80,330 110,310 140,320 170,300 200,310 230,285 260,295 290,270 320,280" 
    fill="none" stroke="#f97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="4 2"/>

  <!-- Orders list -->
  <rect x="364" y="216" width="132" height="130" rx="10" fill="#f8fafc"/>
  <rect x="376" y="232" width="108" height="10" rx="5" fill="#e2e8f0"/>
  <rect x="376" y="252" width="80" height="8" rx="4" fill="#dbeafe"/>
  <rect x="376" y="268" width="90" height="8" rx="4" fill="#dbeafe"/>
  <rect x="376" y="284" width="70" height="8" rx="4" fill="#dbeafe"/>
  <rect x="376" y="300" width="85" height="8" rx="4" fill="#dbeafe"/>
  <rect x="376" y="316" width="75" height="8" rx="4" fill="#dbeafe"/>
  <rect x="440" y="252" width="32" height="8" rx="4" fill="#bbf7d0"/>
  <rect x="440" y="268" width="32" height="8" rx="4" fill="#fed7aa"/>
  <rect x="440" y="284" width="32" height="8" rx="4" fill="#bbf7d0"/>
  <rect x="440" y="300" width="32" height="8" rx="4" fill="#bbf7d0"/>
  <rect x="440" y="316" width="32" height="8" rx="4" fill="#fed7aa"/>
</svg>
