<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 360">
  <!-- Monitor bezel -->
  <rect x="30" y="20" width="420" height="290" rx="12" fill="#1f2937"/>
  <!-- Screen -->
  <rect x="40" y="30" width="400" height="270" rx="8" fill="#111827"/>
  <!-- Top toolbar -->
  <rect x="40" y="30" width="400" height="32" rx="8" fill="#1f2937"/>
  <rect x="40" y="50" width="400" height="12" fill="#1f2937"/>
  <!-- Tab pills -->
  <rect x="52" y="36" width="52" height="18" rx="9" fill="#22c55e"/>
  <rect x="52" y="39" width="52" height="12" rx="6" fill="#22c55e"/>
  <rect x="112" y="36" width="52" height="18" rx="9" fill="#374151"/>
  <rect x="172" y="36" width="52" height="18" rx="9" fill="#374151"/>
  <rect x="232" y="36" width="52" height="18" rx="9" fill="#374151"/>
  <!-- Stat pills top right -->
  <rect x="340" y="36" width="36" height="18" rx="9" fill="#ef4444" opacity="0.8"/>
  <rect x="382" y="36" width="36" height="18" rx="9" fill="#f59e0b" opacity="0.8"/>
  <!-- Ticket columns -->
  <!-- Column 1 - Active (green header) -->
  <rect x="48" y="70" width="116" height="220" rx="8" fill="#1a2535"/>
  <rect x="48" y="70" width="116" height="28" rx="8" fill="#16a34a"/>
  <rect x="48" y="86" width="116" height="12" fill="#16a34a"/>
  <rect x="56" y="76" width="50" height="14" rx="4" fill="white" opacity="0.5"/>
  <rect x="56" y="106" width="100" height="10" rx="4" fill="#6b7280"/>
  <rect x="56" y="122" width="80" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <rect x="56" y="136" width="90" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <rect x="56" y="150" width="70" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <rect x="56" y="168" width="100" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <rect x="56" y="182" width="85" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <!-- Column 2 - Delivery (blue header) -->
  <rect x="172" y="70" width="116" height="220" rx="8" fill="#1a2535"/>
  <rect x="172" y="70" width="116" height="28" rx="8" fill="#2563eb"/>
  <rect x="172" y="86" width="116" height="12" fill="#2563eb"/>
  <rect x="180" y="76" width="50" height="14" rx="4" fill="white" opacity="0.5"/>
  <rect x="180" y="106" width="100" height="10" rx="4" fill="#6b7280"/>
  <rect x="180" y="122" width="80" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <rect x="180" y="136" width="90" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <rect x="180" y="150" width="100" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <rect x="180" y="164" width="75" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <rect x="180" y="178" width="90" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <rect x="180" y="192" width="60" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <!-- Column 3 - Collection (orange header) -->
  <rect x="296" y="70" width="116" height="220" rx="8" fill="#1a2535"/>
  <rect x="296" y="70" width="116" height="28" rx="8" fill="#f97316"/>
  <rect x="296" y="86" width="116" height="12" fill="#f97316"/>
  <rect x="304" y="76" width="50" height="14" rx="4" fill="white" opacity="0.5"/>
  <rect x="304" y="106" width="100" height="10" rx="4" fill="#6b7280"/>
  <rect x="304" y="122" width="80" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <rect x="304" y="136" width="90" height="8" rx="4" fill="#9ca3af" opacity="0.5"/>
  <!-- Monitor stand -->
  <rect x="210" y="310" width="60" height="12" rx="4" fill="#374151"/>
  <rect x="190" y="320" width="100" height="10" rx="5" fill="#4b5563"/>
</svg>
